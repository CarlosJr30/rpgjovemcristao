{
  "name": "rpg-jovem-cristao",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=24.16.0 <25",
    "npm": ">=11.13.0 <12"
  },
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@rpg/web",
    "build": "npm run build --workspace=@rpg/web",
    "start": "npm run start --workspace=@rpg/web",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "npm run typecheck --workspaces && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write apps/web packages tests/e2e *.json *.ts *.mjs .prettierrc.json README.md docs/architecture/BOOTSTRAP.md",
    "format:check": "prettier --check apps/web packages tests/e2e *.json *.ts *.mjs .prettierrc.json README.md docs/architecture/BOOTSTRAP.md"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "5.0.1"
  }
}

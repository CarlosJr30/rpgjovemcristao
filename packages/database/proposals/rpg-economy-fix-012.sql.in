-- Installs an actor-bound, explicit zero-baseline initialization command.
-- No avatar is initialized by this migration; no balances/items are granted.
SET LOCAL lock_timeout='5s'; SET LOCAL statement_timeout='45s';
DO $$ BEGIN
 IF current_setting('economyfix012.target_project',true) IS DISTINCT FROM '__PROJECT__'
 OR public.release_scope() IS DISTINCT FROM '__SCOPE__' OR public.economy_protocol_version()<>3
 OR md5(replace(pg_get_functiondef('shop_private.state(uuid)'::regprocedure),E'\r\n',E'\n')) IS DISTINCT FROM '__STATE_HASH__'
 OR (SELECT md5(pg_get_constraintdef(oid)) FROM pg_constraint WHERE conrelid='public.chest_operations'::regclass AND conname='chest_operations_type_check') IS DISTINCT FROM '__CONSTRAINT_HASH__'
 OR to_regprocedure('shop_private.reconciliation_snapshot_010(uuid)') IS NULL
 OR to_regprocedure('shop_private.initialize_012(uuid)') IS NOT NULL
 THEN RAISE EXCEPTION 'Reviewed economic initialization boundary required' USING ERRCODE='42501'; END IF;
END $$;

CREATE FUNCTION shop_private.pristine_012(p_actor uuid) RETURNS boolean
LANGUAGE sql STABLE SECURITY DEFINER SET search_path='' AS $$
 SELECT EXISTS(
  SELECT 1 FROM public.travelers t
  JOIN public.wallets w ON w.traveler_id=t.id
  JOIN public.traveler_stats s ON s.traveler_id=t.id
  WHERE t.id=p_actor AND t.economic_verified_at IS NULL AND t.level=1 AND t.xp=0
  AND (t.journey_progress IS NULL OR t.journey_progress='{}'::jsonb)
  AND w.coins=0 AND w.created_at=t.created_at AND w.updated_at=w.created_at
  AND s.created_at=t.created_at AND s.updated_at=s.created_at
  AND s.base_life=1 AND s.base_strength=1 AND s.base_defense=1 AND s.base_wisdom=1
  -- Only the original, fixed creation allocation is accepted. Zero coins alone are insufficient.
  AND (SELECT count(*) FROM public.inventory i WHERE i.traveler_id=t.id)=1
  AND EXISTS(SELECT 1 FROM public.inventory i WHERE i.traveler_id=t.id
   AND i.item_id='traveler-boots' AND i.quantity=1 AND i.metadata IS NULL
   AND i.acquired_at=t.created_at AND i.card_receipt_id IS NULL AND i.card_version IS NULL
   AND i.card_revoked_at IS NULL AND i.card_revocation_receipt_id IS NULL
   AND to_jsonb(i)->>'arena_qa_receipt_id' IS NULL)
  AND NOT EXISTS(SELECT 1 FROM public.equipped_items e WHERE e.traveler_id=t.id
   AND (e.slot<>'boots' OR e.item_id<>'traveler-boots'))
  AND NOT EXISTS(
   SELECT 1 FROM public.chest_operations x WHERE x.traveler_id=t.id
   UNION ALL SELECT 1 FROM public.traveler_chests x WHERE x.traveler_id=t.id
   UNION ALL SELECT 1 FROM public.guild_reward_claims x WHERE x.traveler_id=t.id
   UNION ALL SELECT 1 FROM public.guild_ebd_reward_pending x WHERE x.traveler_id=t.id
   UNION ALL SELECT 1 FROM public.story_progress x WHERE x.traveler_id=t.id
   UNION ALL SELECT 1 FROM story_private.step_receipts x WHERE x.traveler_id=t.id
   UNION ALL SELECT 1 FROM economy_private.battles x WHERE x.traveler_id=t.id
   UNION ALL SELECT 1 FROM economy_private.journeys x WHERE x.traveler_id=t.id
   UNION ALL SELECT 1 FROM economy_private.journey_operations x WHERE x.traveler_id=t.id
   UNION ALL SELECT 1 FROM economy_private.journey_rewards x WHERE x.traveler_id=t.id
   UNION ALL SELECT 1 FROM economy_private.community_xp_holds x WHERE x.traveler_id=t.id
   UNION ALL SELECT 1 FROM economy_private.community_chest_holds x WHERE x.traveler_id=t.id
   UNION ALL SELECT 1 FROM shop_private.holds x WHERE x.traveler_id=t.id
   UNION ALL SELECT 1 FROM economy_qa_private.profiles x WHERE x.traveler_id=t.id
   UNION ALL SELECT 1 FROM economy_qa_private.receipts x WHERE x.traveler_id=t.id
  )
 )
$$;
REVOKE ALL ON FUNCTION shop_private.pristine_012(uuid) FROM PUBLIC,anon,authenticated,service_role;

DO $$ DECLARE prior text; BEGIN
 SELECT pg_get_constraintdef(oid) INTO prior FROM pg_constraint
 WHERE conrelid='public.chest_operations'::regclass AND conname='chest_operations_type_check';
 ALTER TABLE public.chest_operations DROP CONSTRAINT chest_operations_type_check;
 EXECUTE 'ALTER TABLE public.chest_operations ADD CONSTRAINT chest_operations_type_check CHECK (('||
 substring(prior FROM 8 FOR char_length(prior)-8)||') OR (operation_type=''economic-initialization''
 AND chest_type IS NULL AND price_paid=0 AND account_id IS NOT NULL AND source=''economic-init-012''
 AND rewards->>''contract''=''RPG-ECONOMY-FIX-012:v1'' AND rewards->>''baselineCoins''=''0'' AND rewards->>''baselineXP''=''0''))';
END $$;

CREATE FUNCTION shop_private.protect_initialization_012() RETURNS trigger
LANGUAGE plpgsql SECURITY INVOKER SET search_path='' AS $$ BEGIN
 IF TG_OP<>'INSERT' AND OLD.operation_type='economic-initialization' THEN
  RAISE EXCEPTION 'Initialization audit is append only' USING ERRCODE='42501';
 END IF;
 IF TG_OP<>'DELETE' AND NEW.operation_type='economic-initialization' THEN
  IF TG_OP<>'INSERT' OR current_user<>'postgres'
  OR current_setting('economyfix012.initializing_actor',true) IS DISTINCT FROM NEW.traveler_id::text
  OR NEW.account_id IS DISTINCT FROM auth.uid()
  OR NEW.identity_key IS DISTINCT FROM 'economic-init-012:'||NEW.traveler_id
  OR NEW.operation_key IS DISTINCT FROM 'economic-init-012'
  OR NEW.source IS DISTINCT FROM 'economic-init-012' OR NEW.price_paid IS DISTINCT FROM 0
  OR NEW.rewards->>'contract' IS DISTINCT FROM 'RPG-ECONOMY-FIX-012:v1'
  OR NEW.rewards->>'baselineCoins' IS DISTINCT FROM '0' OR NEW.rewards->>'baselineXP' IS DISTINCT FROM '0'
  OR NEW.rewards->>'newCurrencyGranted' IS DISTINCT FROM '0' OR NEW.rewards->>'newItemsGranted' IS DISTINCT FROM '0'
  OR coalesce(NEW.rewards->>'snapshot','')!~'^[0-9a-f]{32}$'
  OR NOT shop_private.pristine_012(NEW.traveler_id)
  THEN RAISE EXCEPTION 'Actor-bound pristine initialization audit required' USING ERRCODE='42501'; END IF;
 END IF;
 IF TG_OP='DELETE' THEN RETURN OLD; END IF; RETURN NEW;
END $$;
REVOKE ALL ON FUNCTION shop_private.protect_initialization_012() FROM PUBLIC,anon,authenticated,service_role;
CREATE TRIGGER protect_initialization_012 BEFORE INSERT OR UPDATE OR DELETE ON public.chest_operations
FOR EACH ROW EXECUTE FUNCTION shop_private.protect_initialization_012();

CREATE FUNCTION shop_private.initialize_012(p_actor uuid) RETURNS jsonb
LANGUAGE plpgsql SECURITY DEFINER SET search_path='' AS $$
DECLARE who uuid; t public.travelers; receipt uuid; snapshot text; BEGIN
 IF public.release_scope() IS DISTINCT FROM '__SCOPE__'
 OR NOT EXISTS(SELECT 1 FROM shop_private.policy WHERE singleton AND enabled)
 THEN RAISE EXCEPTION 'Economic initialization unavailable' USING ERRCODE='42501'; END IF;
 PERFORM pg_advisory_xact_lock(1010,1);
 who:=economy_private.community_xp_actor(p_actor);
 SELECT * INTO t FROM public.travelers WHERE id=p_actor AND user_id=who AND is_active FOR UPDATE;
 IF NOT FOUND THEN RAISE EXCEPTION 'Active owned avatar required' USING ERRCODE='42501'; END IF;
 IF t.economic_verified_at IS NOT NULL THEN
  RETURN jsonb_build_object('version',1,'qaOnly',false,'status','already-initialized');
 END IF;
 PERFORM 1 FROM public.wallets WHERE traveler_id=p_actor FOR UPDATE;
 PERFORM 1 FROM public.traveler_stats WHERE traveler_id=p_actor FOR UPDATE;
 PERFORM 1 FROM public.inventory WHERE traveler_id=p_actor ORDER BY id FOR UPDATE;
 PERFORM 1 FROM public.equipped_items WHERE traveler_id=p_actor ORDER BY slot FOR UPDATE;
 PERFORM 1 FROM public.traveler_chests WHERE traveler_id=p_actor ORDER BY chest_type FOR UPDATE;
 PERFORM 1 FROM public.chest_operations WHERE traveler_id=p_actor ORDER BY id FOR UPDATE;
 -- Revalidate after waiting for account/avatar locks. Existing/new positive value cannot be laundered.
 PERFORM economy_private.community_xp_actor(p_actor);
 IF NOT shop_private.pristine_012(p_actor) THEN
  RAISE EXCEPTION 'Legacy provenance review required' USING ERRCODE='42501'; END IF;
 snapshot:=shop_private.reconciliation_snapshot_010(p_actor);
 PERFORM set_config('economyfix012.initializing_actor',p_actor::text,true);
 INSERT INTO public.chest_operations(traveler_id,operation_key,operation_type,chest_type,source,price_paid,account_id,identity_key,rewards)
 VALUES(p_actor,'economic-init-012','economic-initialization',NULL,'economic-init-012',0,who,'economic-init-012:'||p_actor,
 jsonb_build_object('contract','RPG-ECONOMY-FIX-012:v1','basis','unchanged-initial-allocation',
 'baselineCoins',0,'baselineXP',0,'newCurrencyGranted',0,'newItemsGranted',0,'snapshot',snapshot)) RETURNING id INTO receipt;
 UPDATE public.travelers SET economic_verified_at=clock_timestamp()
 WHERE id=p_actor AND user_id=who AND is_active AND economic_verified_at IS NULL;
 IF NOT FOUND OR NOT shop_private.balance_valid(p_actor) THEN
  RAISE EXCEPTION 'Initialization consistency failed' USING ERRCODE='42501'; END IF;
 RETURN jsonb_build_object('version',1,'qaOnly',false,'status','initialized','receiptId',receipt);
END $$;
REVOKE ALL ON FUNCTION shop_private.initialize_012(uuid) FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION shop_private.initialize_012(uuid) TO authenticated;
CREATE FUNCTION public.initialize_shop_economy(p_actor uuid) RETURNS jsonb
LANGUAGE sql SECURITY INVOKER SET search_path='' AS $$ SELECT shop_private.initialize_012(p_actor) $$;
REVOKE ALL ON FUNCTION public.initialize_shop_economy(uuid) FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION public.initialize_shop_economy(uuid) TO authenticated;

-- Add classification to the existing own-state read, without activating on reads.
DO $$ DECLARE body text; BEGIN
 SELECT pg_get_functiondef('shop_private.state(uuid)'::regprocedure) INTO body;
 IF position('''catalogVersion'',''ECONOMY-001C:shop:v1''' IN body)=0 THEN
  RAISE EXCEPTION 'Frozen state response changed' USING ERRCODE='42501'; END IF;
 body:=replace(body,'''catalogVersion'',''ECONOMY-001C:shop:v1''',
 '''initializationEligible'',coalesce(reason=''legacy-reconciliation-required'' AND has_function_privilege(''authenticated'',''shop_private.initialize_012(uuid)'',''EXECUTE'') AND shop_private.pristine_012(p_actor),false),''catalogVersion'',''ECONOMY-001C:shop:v1''');
 EXECUTE body;
END $$;
NOTIFY pgrst,'reload schema';
